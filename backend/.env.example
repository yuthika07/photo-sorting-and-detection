# -----------------------------------------------------------------------
# Wedding Photo Organizer — Backend Environment Variables (EXAMPLE)
# Copy this file to ".env" and adjust values for your machine.
# Never commit the real ".env" file — only this example is version controlled.
# -----------------------------------------------------------------------

# Human-readable name of the application, shown in logs and API docs
APP_NAME="Wedding Photo Organizer"

# Current app version, surfaced on the /health endpoint
APP_VERSION="0.1.0"

# Runtime environment: "development", "production", or "test"
APP_ENV="development"

# Enables FastAPI's interactive docs (/docs, /redoc) — disable in production builds
ENABLE_DOCS=true

# Host/port the local FastAPI server binds to (the desktop shell talks to this)
HOST="127.0.0.1"
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Directory (relative to backend/) where log files are written
LOG_DIR="../data/logs"

# Directory (relative to backend/) where the SQLite DB file will live (Phase 2)
DATA_DIR="../data"

# Comma-separated list of origins allowed to call this API.
# The desktop webview usually loads from a local origin like tauri://localhost.
CORS_ORIGINS="http://localhost:3000,tauri://localhost"
